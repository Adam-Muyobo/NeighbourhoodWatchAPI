###
# nwa-patrols.http
# Patrol Management Endpoints Test File
###

@host = http://localhost:8080

# Ensure officerUUID and checkpointUUID exist from previous tests
@officerUUID = e0d826de-dab7-4b5d-b5ef-6e32de57e516
@checkpointUUID = 3f674554-5558-4af1-8e2e-08cb15a05ce0

###
# 1) Create a Patrol
###
POST {{host}}/api/patrols/{{officerUUID}}/{{checkpointUUID}}?comment=Routine check&anomalyFlag=false&latitude=-24.654321&longitude=25.912345

> {%
    client.test("Create Patrol: Status 200", function() {
        client.assert(response.status === 200, "Failed to create patrol");
        var patrol = response.body;
        client.global.set("patrolUUID", patrol.patrolUUID);
    })
%}

###
# 2) Get all Patrols
###
GET {{host}}/api/patrols
Accept: application/json

> {%
    client.test("Get all patrols: Status 200", function() {
        client.assert(response.status === 200, "Failed to retrieve patrols");
    })
%}

###
# 3) Get Patrol by UUID
###
GET {{host}}/api/patrols/{{patrolUUID}}
Accept: application/json

> {%
    client.test("Get patrol by UUID: Status 200", function() {
        client.assert(response.status === 200, "Failed to retrieve patrol");
    })
%}

###
# 4) Update Patrol comment & anomaly flag
###
PUT {{host}}/api/patrols/{{patrolUUID}}?comment=Updated check note&anomalyFlag=true

> {%
    client.test("Update Patrol: Status 200", function() {
        client.assert(response.status === 200, "Failed to update patrol");
    })
%}

###
# 5) Delete Patrol
###
DELETE {{host}}/api/patrols/{{patrolUUID}}

> {%
    client.test("Delete Patrol: Status 204", function() {
        client.assert(response.status === 204, "Failed to delete patrol");
    })
%}

###
# 6) Confirm deletion should return 404
###
GET {{host}}/api/patrols/{{patrolUUID}}
Accept: application/json

> {%
    client.test("Patrol should be deleted: Expect 404", function() {
        client.assert(response.status === 404, "Expected 404 after deletion");
    })
%}
