###
# nwa-checkpoints.http
# Checkpoint Management Endpoints Test File
###

@host = http://localhost:8080

###
# 1) Create checkpoint (no house, with user-defined code)
###
POST {{host}}/api/checkpoints
Content-Type: application/json

{
  "code": "HOU001",
  "name": "North Gate",
  "type": "GATE",
  "description": "Main entry gate for North Sector",
  "location": "North Road"
}

> {%
    client.test("Create checkpoint (no house, with code): Status 200", function() {
        client.assert(response.status === 200, "Failed to create checkpoint");
        var checkpoint = response.body;
        client.global.set("checkpointUUID", checkpoint.checkpointUUID);
        client.global.set("checkpointCode", checkpoint.code);
    })
%}


###
# 2) Create checkpoint with house reference (replace HOUSE_UUID below)
###
POST {{host}}/api/checkpoints
Content-Type: application/json

{
  "code": "HOU002",
  "name": "Block A House Check",
  "type": "HOUSE",
  "description": "House checkpoint for block surveillance",
  "location": "Block A Street",
  "houseUUID": "{{houseUUID}}"
}

> {%
    client.test("Create checkpoint with house reference: Status 200", function() {
        client.assert(response.status === 200, "Failed to create checkpoint with house reference");
        var checkpoint = response.body;
        client.global.set("checkpointWithHouseUUID", checkpoint.checkpointUUID);
        client.global.set("checkpointWithHouseCode", checkpoint.code);
    })
%}


###
# 3) Get all checkpoints
###
GET {{host}}/api/checkpoints
Accept: application/json

> {%
    client.test("Get all checkpoints: Status 200", function() {
        client.assert(response.status === 200, "Failed to retrieve checkpoints list");
    })
%}


###
# 4) Get checkpoint by UUID
###
GET {{host}}/api/checkpoints/{{checkpointUUID}}
Accept: application/json

> {%
    client.test("Get checkpoint by UUID: Status 200", function() {
        client.assert(response.status === 200, "Failed to retrieve checkpoint by UUID");
    })
%}


###
# 5) Get checkpoint by Code
###
GET {{host}}/api/checkpoints/code/{{checkpointCode}}
Accept: application/json

> {%
    client.test("Get checkpoint by Code: Status 200", function() {
        client.assert(response.status === 200, "Failed to retrieve checkpoint by Code");
    })
%}


###
# 6) Update checkpoint
###
PUT {{host}}/api/checkpoints/{{checkpointUUID}}
Content-Type: application/json

{
  "description": "Updated note and patrol zone info",
  "location": "New North Patrol Zone"
}

> {%
    client.test("Update checkpoint: Status 200", function() {
        client.assert(response.status === 200, "Failed to update checkpoint details");
    })
%}


###
# 7) Delete checkpoint
###
DELETE {{host}}/api/checkpoints/{{checkpointUUID}}

> {%
    client.test("Delete checkpoint: Status 204", function() {
        client.assert(response.status === 204, "Failed to delete checkpoint");
    })
%}


###
# 8) Confirm deletion should return 404
###
GET {{host}}/api/checkpoints/{{checkpointUUID}}
Accept: application/json

> {%
    client.test("Checkpoint should be deleted: Expect 404", function() {
        client.assert(response.status === 404, "Expected 404 after deletion");
    })
%}
